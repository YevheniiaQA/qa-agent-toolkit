{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Requirements index",
  "description": "02-analysis/<TICKET>/requirements/_index.json, written by requirements-decomposer. Cross-references (AC -> requirement, requirement -> question) are checked by qa-gate reqs, not here.",
  "type": "object",
  "required": ["ticket", "requirements", "acceptanceCriteria"],
  "properties": {
    "ticket": {"type": "string", "minLength": 1},
    "title": {"type": "string"},
    "createdAt": {"type": "string"},
    "source": {"type": ["object", "string"]},
    "sourceLanguage": {"type": "string"},
    "interfaceLanguage": {"type": "string"},
    "stories": {"type": "array", "items": {"type": "string", "pattern": "^US-\\d+"}},
    "tasks": {"type": "array", "items": {"type": "string", "pattern": "^TASK-\\d+"}},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text", "source"],
        "properties": {
          "id": {"type": "string", "pattern": "^N?F-[A-Za-z0-9][A-Za-z0-9-]*-[A-Z0-9]+-\\d{2,}$"},
          "text": {"type": "string", "minLength": 5},
          "source": {"type": "string", "minLength": 1},
          "layer": {"type": "string", "pattern": "^[A-Z0-9]+$"},
          "status": {"type": "string", "pattern": "^[a-z]+(-[a-z]+)*$"},
          "task": {"type": ["string", "null"]},
          "story": {"type": ["string", "null"]},
          "questions": {"type": "array", "items": {"type": "string", "pattern": "^Q-\\d+"}},
          "finding": {"type": ["string", "null"]}
        }
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "given", "when", "then"],
        "properties": {
          "id": {"type": "string", "pattern": "^AC-"},
          "story": {"type": ["string", "null"]},
          "given": {"type": "string", "minLength": 1},
          "when": {"type": "string", "minLength": 1},
          "then": {"type": "string", "minLength": 1},
          "requirements": {"type": "array", "items": {"type": "string"}},
          "origin": {"type": "string"}
        }
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {"type": "string", "pattern": "^Q-\\d+"},
          "default": {"type": ["string", "null"]},
          "blocks": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
